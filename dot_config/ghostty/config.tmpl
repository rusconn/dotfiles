# window
macos-titlebar-style = tabs
macos-window-buttons = hidden

# shell
command = {{ lookPath "fish" | default "fish" }}

# key
macos-option-as-alt = left

# font
font-style = Bold
font-size = 12
font-thicken = true
font-feature = -calt
font-feature = -liga

# cell
adjust-cell-height = 1

# theme
theme = 0x96f

# background
background-opacity = 1

# selection
selection-background = #304E75
selection-foreground = cell-foreground
