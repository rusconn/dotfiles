# Create directories on first run (for history and compinit dump)
[[ -d "$XDG_STATE_HOME/zsh" && -d "$XDG_CACHE_HOME/zsh" ]] ||
  mkdir -p "$XDG_STATE_HOME/zsh" "$XDG_CACHE_HOME/zsh"

# zsh
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME}/zsh/zcompdump-$ZSH_VERSION"

# prompt
PROMPT='%c %# '

# disable ctrl-s, ctrl-q
setopt no_flow_control

# bash-like time format
TIMEFMT=$'\nreal\t%*Es\nuser\t%*Us\nsys\t%*Ss'

# history config
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_NO_STORE
setopt SHARE_HISTORY

# Rust
export PATH="$CARGO_HOME/bin:$PATH"

# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ffmpeg-full
if [[ -d /opt/homebrew/opt/ffmpeg-full/bin ]]; then
  export PATH="/opt/homebrew/opt/ffmpeg-full/bin:$PATH"
elif [[ -d /usr/local/opt/ffmpeg-full/bin ]]; then
  export PATH="/usr/local/opt/ffmpeg-full/bin:$PATH"
elif [[ -d /home/linuxbrew/.linuxbrew/opt/ffmpeg-full/bin ]]; then
  export PATH="/home/linuxbrew/.linuxbrew/opt/ffmpeg-full/bin:$PATH"
fi

# libpq
if [[ -d /opt/homebrew/opt/libpq/bin ]]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
elif [[ -d /usr/local/opt/libpq/bin ]]; then
  export PATH="/usr/local/opt/libpq/bin:$PATH"
elif [[ -d /home/linuxbrew/.linuxbrew/opt/libpq/bin ]]; then
  export PATH="/home/linuxbrew/.linuxbrew/opt/libpq/bin:$PATH"
fi

# mise
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# OrbStack: command-line tools and integration
source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :

# aliases
alias ll='eza -lha'
