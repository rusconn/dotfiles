{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "/var/**": "allow",
    }

  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "target/**",
      ".git/**",
      "pnpm-lock.yaml",
    ],
  },
}
