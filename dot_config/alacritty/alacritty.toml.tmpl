[window]
startup_mode = "Maximized"
padding = { x = 4, y = 0 }

[scrolling]
history = 1000

[font]
size = 12.0
offset = { x = 0, y = 2 }

[font.normal]
family = "JetBrainsMonoNL Nerd Font Mono"
style = "Medium"

[font.bold]
family = "JetBrainsMonoNL Nerd Font Mono"
style = "Bold"

[colors.selection]
text = "CellForeground"
background = "#304E75"

[terminal.shell]
program = "{{ lookPath "fish" | default "fish" }}"
args = ["-l"]
