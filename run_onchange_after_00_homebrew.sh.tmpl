{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh

# Brewfile hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}

{{- if eq .chezmoi.os "darwin" }}
# Ensure Xcode Command Line Tools are installed
if ! xcode-select -p >/dev/null 2>&1; then
  echo "Xcode Command Line Tools not found. Requesting installation..."
  xcode-select --install
  echo "Please complete the Xcode Command Line Tools installation dialog, then press Enter to continue..."
  read -r _
fi
{{- end }}

printf "Install/Update Homebrew packages from Brewfile? [Y/n]: "
read -r response

if [ "$response" != "n" ] && [ "$response" != "N" ]; then
  # Find brew binary
  BREW_BIN=""
  if command -v brew >/dev/null 2>&1; then
    BREW_BIN="$(command -v brew)"
  elif [ -x "/opt/homebrew/bin/brew" ]; then
    BREW_BIN="/opt/homebrew/bin/brew"
  elif [ -x "/usr/local/bin/brew" ]; then
    BREW_BIN="/usr/local/bin/brew"
  elif [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    BREW_BIN="/home/linuxbrew/.linuxbrew/bin/brew"
  elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
    BREW_BIN="$HOME/.linuxbrew/bin/brew"
  fi

  # Install Homebrew if not found
  if [ -z "$BREW_BIN" ]; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Re-detect after installation
    if [ -x "/opt/homebrew/bin/brew" ]; then
      BREW_BIN="/opt/homebrew/bin/brew"
    elif [ -x "/usr/local/bin/brew" ]; then
      BREW_BIN="/usr/local/bin/brew"
    elif [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
      BREW_BIN="/home/linuxbrew/.linuxbrew/bin/brew"
    elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
      BREW_BIN="$HOME/.linuxbrew/bin/brew"
    elif command -v brew >/dev/null 2>&1; then
      BREW_BIN="$(command -v brew)"
    fi
  fi

  if [ -z "$BREW_BIN" ]; then
    echo "Error: brew command not found after installation attempt."
    exit 1
  fi

  eval "$("$BREW_BIN" shellenv)"

  # Ensure HOMEBREW_BUNDLE_FILE_GLOBAL is set correctly for this non-interactive shell script
  export HOMEBREW_BUNDLE_FILE_GLOBAL="$HOME/.config/homebrew/Brewfile"

  echo "Installing packages from Brewfile..."
  brew bundle --global --no-upgrade
else
  echo "Skipping Homebrew bundle installation by user request."
fi

{{- end -}}
